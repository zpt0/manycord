{
    "name": "manycord",
    "version": "0.1.0",
    "description": "A Vencord plugin that removes or customizes Discord's five-account switcher limit",
    "author": "zpt0.dev",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/zpt0/manycord.git"
    },
    "keywords": [
        "vencord",
        "discord",
        "plugin",
        "account-switcher",
        "userplugin"
    ],
    "type": "module",
    "private": true,
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run lint && npm run format:check"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.71.2"
    }
}
